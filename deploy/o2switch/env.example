# Variables de l’application ADECAP sur o2switch.
# À saisir dans cPanel > Setup Node.js App > Environment variables,
# ou à copier dans un fichier .env à la racine de l’application (même dossier que app.js).

# Base PostgreSQL créée dans cPanel > Bases de données PostgreSQL
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_DE_LA_BASE

# Clé de session : 64 caractères aléatoires (cPanel > Terminal : openssl rand -hex 32)
SESSION_SECRET=

# Premier compte administrateur (utilisé seulement si la base ne contient aucun compte)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur ADECAP

# Adresse publique du site
SITE_URL=https://www.adecapentertainment.com

# Stockage des médias : Cloudflare R2 (laisser vide pour garder les images dans la base)
S3_ENDPOINT=https://ID_DE_COMPTE.r2.cloudflarestorage.com
S3_BUCKET=adecap
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://medias.adecapentertainment.com
S3_REGION=auto
